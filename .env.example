LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
BOCHA_API_KEY=your-bocha-api-key
BOCHA_BASE_URL=https://api.bochaai.com
# 深研主编排 recursion 预算（越大越不易中途截断，也更耗 token）
AGENT_MAX_TOOL_ROUNDS=16
# 追问 Agent 单轮硬上限（工具调用次数 / 模型调用次数）
FOLLOWUP_TOOL_RUN_LIMIT=16
FOLLOWUP_MODEL_RUN_LIMIT=24

# 业务库（异步 SQLAlchemy：AsyncEngine + AsyncSession）
# SQLite 会自动规范为 sqlite+aiosqlite:///绝对路径
DATABASE_URL=sqlite+aiosqlite:///./data/app_local_sqlite.db
# 密码含特殊字符须 URL 编码（如 ? → %3F）
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/a_stock
#
# 完整自包含演示（含 Postgres + 官方 Milvus）请用：
#   docker compose -f docker-compose.demo.yml up -d --build
# 该文件会覆盖 DATABASE_URL 为容器内服务名 postgres（见 docker-compose.demo.yml）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# 向量库：chroma 本地 / milvus 生产
VECTOR_BACKEND=chroma
VECTOR_CHROMA_DIR=./data/vector_chroma
# VECTOR_BACKEND=milvus
# VECTOR_MILVUS_URI=http://127.0.0.1:19530
# VECTOR_MILVUS_URI=./data/milvus_lite.db
VECTOR_MILVUS_URI=http://127.0.0.1:19530
VECTOR_MILVUS_TOKEN=
VECTOR_MILVUS_DB=default

# Debug：true 时写 app_debug.log，并开放 /docs · /redoc · 侧栏「API 文档」
DEBUG=false

# 用户认证（JWT）。关闭时行为与旧版一致：报告全局可见、同 code 全局互斥
AUTH_ENABLED=false
JWT_SECRET=please-change-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
# 是否开放自助注册；生产建议 false，用引导账号
AUTH_ALLOW_REGISTER=false
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=change-this-password
# 改密后一次性设 true，启动时同步引导账号密码；平时保持 false
AUTH_BOOTSTRAP_SYNC_PASSWORD=false
# 或手动重置：
#   python -m app.scripts.reset_user_password --username admin --from-env
# 开启认证后，把旧报告（user_id 为空）归到 admin：
#   python -m app.scripts.migrate_orphan_reports
#   python -m app.scripts.migrate_orphan_reports --dry-run

# Embedding（DashScope OpenAI 兼容）
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# RAG 入库 / 召回
RAG_ENABLED=true
RAG_FOLLOWUP_TOOL=true
RAG_COLLECTION=a_share_rag
RAG_PARENT_CHUNK_SIZE=1200
RAG_CHILD_CHUNK_SIZE=400
RAG_CHILD_CHUNK_OVERLAP=80
RAG_JSON_PARENT_CHUNK_SIZE=2400
RAG_JSON_CHILD_CHUNK_SIZE=560
RAG_JSON_CHILD_CHUNK_OVERLAP=100
RAG_MAX_OUTPUT_CHARS=80000
RAG_STALE_HOURS=24
